---
import '@fontsource/archivo/900.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import meta from '../content/repo/meta.json';

interface Props {
  title: string;
  description: string;
  /** JSON-LD structured data, only set on the landing page */
  schema?: Record<string, unknown>;
}

const { title, description, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const REPO = 'https://github.com/kelvincushman/orphus';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="theme-color" content="#000000" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="banner" href="/changelog">
      <span class="pulse" aria-hidden="true"></span>
      <span class="mono btxt"
        ><strong>v2.1 coming soon</strong> — Goal-driven completion, live worker
        visibility <span class="arrow">→ read what's changing</span></span
      >
    </a>

    <header class="nav">
      <div class="wrap navrow">
        <a class="mark" href="/" aria-label="Orphus home">
          <span class="glyph" aria-hidden="true">▚</span><span class="name">orphus</span>
        </a>
        <nav class="links" aria-label="Main">
          <a href="https://github.com/kelvincushman/orphus/blob/main/docs/README.md">/docs</a>
          <a href="/install">/install</a>
          <a href="/changelog">/changelog</a>
        </nav>
        <div class="actions">
          <a class="gh" href={REPO}>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              /></svg
            >
            <span>{meta.stars}</span>
          </a>
          <a class="btn fill navbtn" href="/install">install</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap footrow">
        <nav class="footlinks" aria-label="Footer">
          <a href="https://github.com/kelvincushman/orphus/blob/main/docs/README.md">/docs</a>
          <a href="/install">/install</a>
          <a href="/changelog">/changelog</a>
          <a href="/security">/security</a>
          <a href="/legal/licence">/legal/licence</a>
          <a href="/legal/privacy">/legal/privacy</a>
        </nav>
        <p class="footmeta">
          MIT © 2026 Kelvin Lee · fork of <a href="https://github.com/bastani-inc/atomic">Atomic</a> (Bastani, Inc.) ·
          {meta.latestRelease}
        </p>
        <p class="footmeta">
          <a href={REPO}>github</a> · <a href={`${REPO}/issues`}>issues</a> · built
          by <a href="https://kelvinlee.io">Kelvin Lee</a>
        </p>
      </div>
    </footer>

    <style>
      .banner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 8px 16px;
        background: var(--green-tint);
        border-bottom: 1px solid var(--line);
        color: var(--white);
      }
      .banner:hover { color: var(--white); background: rgba(0, 255, 65, 0.1); }
      .btxt { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.02em; }
      .btxt strong { color: var(--green); font-weight: 700; }
      .banner .arrow { color: var(--grey); }
      .banner:hover .arrow { color: var(--green); }
      .pulse {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--green);
        flex-shrink: 0;
        animation: pulse 2.4s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 255, 65, 0.5); }
        50% { opacity: 0.6; box-shadow: 0 0 0 5px rgba(0, 255, 65, 0); }
      }

      .nav {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(0, 0, 0, 0.86);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .navrow {
        display: flex;
        align-items: center;
        gap: 28px;
        height: 58px;
      }
      .mark {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 17px;
        letter-spacing: 0.02em;
        color: var(--white);
      }
      .mark:hover { color: var(--white); }
      .glyph { color: var(--green); font-size: 15px; }
      .links {
        display: flex;
        gap: 22px;
        margin-left: auto;
      }
      .links a {
        font-family: var(--font-mono);
        font-size: 12.5px;
        letter-spacing: 0.06em;
        color: var(--grey);
      }
      .links a:hover { color: var(--green); }
      .actions { display: flex; align-items: center; gap: 14px; }
      .gh {
        display: flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--white);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 6px 12px;
      }
      .gh:hover { border-color: var(--green-dim); color: var(--green); }
      .navbtn { padding: 8px 16px; font-size: 12px; }

      .foot {
        border-top: 1px solid var(--line);
        padding: 28px 0 40px;
      }
      .footrow {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 10px 28px;
        font-family: var(--font-mono);
        font-size: 12.5px;
      }
      .footlinks { display: flex; flex-wrap: wrap; gap: 8px 18px; }
      .footlinks a { color: var(--grey); }
      .footlinks a:hover { color: var(--green); }
      .footmeta { margin: 0; color: var(--grey); }
      .footmeta a { color: var(--white); }
      .footmeta a:hover { color: var(--green); }
      .footrow p:last-child { margin-left: auto; }

      @media (max-width: 860px) {
        .links { display: none; }
        .footrow p:last-child { margin-left: 0; }
      }
    </style>
  </body>
</html>
