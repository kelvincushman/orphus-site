---
import Base from '../layouts/Base.astro';
import { Content as ReleaseNotes } from '../content/repo/release-notes.md';
import meta from '../content/repo/meta.json';
---

<Base
  title="Changelog — Orphus"
  description="Orphus release notes, rendered from the repo's RELEASE_NOTES.md. The repository is the source of truth."
>
  <div class="wrap page">
    <div class="section-head">
      <span class="label"><span class="comment">// changelog</span></span>
      <span class="label hint">rendered from RELEASE_NOTES.md</span>
    </div>
    <div class="prose">
      <p class="note mono">
        Latest published release: <strong>{meta.latestRelease}</strong>. The notes
        below are <code>main</code>'s <code>RELEASE_NOTES.md</code> as of the last
        sync. <a href="https://github.com/kelvincushman/orphus/releases"
          >All releases on GitHub →</a
        >
      </p>
      <ReleaseNotes />
      <p>
        <a href="https://github.com/kelvincushman/orphus/blob/main/RELEASE_NOTES.md"
          >Edit this page on GitHub →</a
        >
      </p>
    </div>
  </div>
</Base>

<style>
  .page { padding: 48px 0 80px; }
  .note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--grey);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 16px;
    background: var(--green-tint);
  }
  .note strong { color: var(--green); }
</style>
